{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "46rem",
			"wideSize": "75rem"
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vh",
				"vw",
				"svh"
			],
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"name": "8 (XS)",
					"slug": "10",
					"size": "0.5rem"
				},
				{
					"name": "16 (S)",
					"slug": "20",
					"size": "1rem"
				},
				{
					"name": "24 (M)",
					"slug": "30",
					"size": "1.5rem"
				},
				{
					"name": "32 (L)",
					"slug": "40",
					"size": "2rem"
				},
				{
					"name": "40 (XL)",
					"slug": "50",
					"size": "2.5rem"
				},
				{
					"name": "48 (2XL)",
					"slug": "60",
					"size": "3rem"
				},
				{
					"name": "64 (3XL)",
					"slug": "70",
					"size": "4rem"
				},
				{
					"name": "80 (4XL)",
					"slug": "80",
					"size": "5rem"
				},
				{
					"name": "96 (5XL)",
					"slug": "90",
					"size": "6rem"
				},
				{
					"name": "128 (6XL)",
					"slug": "100",
					"size": "8rem"
				}
			]
		},
		"typography": {
			"fluid": true,
			"writingMode": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Source Sans 3",
					"fontFamily": "'Source Sans 3', system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Source Sans 3",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-sans-3-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Source Sans 3",
							"fontStyle": "italic",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-sans-3-latin-wght-italic.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Source Sans 3",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-sans-3-latin-ext-wght-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Source Sans 3",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-sans-3-greek-wght-normal.woff2"
							],
							"unicodeRange": "U+0370-0377, U+037A-037F, U+0384-038A, U+038C, U+038E-03A1, U+03A3-03FF"
						},
						{
							"fontFamily": "Source Sans 3",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-sans-3-cyrillic-wght-normal.woff2"
							],
							"unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116"
						}
					]
				},
				{
					"slug": "serif",
					"name": "Source Serif 4",
					"fontFamily": "'Source Serif 4', Georgia, 'Times New Roman', serif",
					"fontFace": [
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-serif-4-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "italic",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-serif-4-latin-wght-italic.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-serif-4-latin-ext-wght-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-serif-4-greek-wght-normal.woff2"
							],
							"unicodeRange": "U+0370-0377, U+037A-037F, U+0384-038A, U+038C, U+038E-03A1, U+03A3-03FF"
						},
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-serif-4-cyrillic-wght-normal.woff2"
							],
							"unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.0625rem",
					"fluid": {
						"min": "1rem",
						"max": "1.0625rem"
					}
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "x-large",
					"name": "X-Large",
					"size": "1.75rem",
					"fluid": {
						"min": "1.4rem",
						"max": "1.75rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "2X-Large",
					"size": "2.25rem",
					"fluid": {
						"min": "1.7rem",
						"max": "2.25rem"
					}
				},
				{
					"slug": "xxx-large",
					"name": "3X-Large",
					"size": "3rem",
					"fluid": {
						"min": "2.1rem",
						"max": "3rem"
					}
				},
				{
					"slug": "huge",
					"name": "Huge",
					"size": "3.75rem",
					"fluid": {
						"min": "2.5rem",
						"max": "3.75rem"
					}
				}
			]
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"color": "#FFFFFF",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#14342B",
					"name": "Primary",
					"slug": "primary"
				},
				{
					"color": "#0B1F19",
					"name": "Primary dark",
					"slug": "primary-dark"
				},
				{
					"color": "#E6EEEA",
					"name": "Primary tint",
					"slug": "primary-tint"
				},
				{
					"color": "#E8DFD0",
					"name": "Secondary",
					"slug": "secondary"
				},
				{
					"color": "#F6F1E9",
					"name": "Secondary tint",
					"slug": "secondary-tint"
				},
				{
					"color": "#1A1A1A",
					"name": "Ink",
					"slug": "ink"
				},
				{
					"color": "#4A4A4A",
					"name": "Ink muted",
					"slug": "ink-muted"
				},
				{
					"color": "#D8D2C8",
					"name": "Line",
					"slug": "line"
				},
				{
					"color": "#000000",
					"name": "Black",
					"slug": "black"
				},
				{
					"color": "#1E7A46",
					"name": "Success",
					"slug": "success"
				},
				{
					"color": "#8A4B00",
					"name": "Warning",
					"slug": "warning"
				},
				{
					"color": "#A81E17",
					"name": "Error",
					"slug": "error"
				}
			]
		},
		"custom": {
			"radius": {
				"sm": "4px",
				"md": "8px",
				"lg": "16px",
				"full": "9999px"
			},
			"shadow": {
				"sm": "0 1px 2px rgba(11, 31, 25, 0.06)",
				"md": "0 4px 12px rgba(11, 31, 25, 0.08)",
				"lg": "0 12px 28px rgba(11, 31, 25, 0.10)"
			},
			"transition": {
				"base": "200ms ease"
			}
		},
		"border": {
			"radius": true,
			"color": true,
			"style": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65",
			"fontWeight": "400"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--30)",
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--30)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--30)"
			}
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "600",
					"lineHeight": "1.2"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxx-large)",
					"lineHeight": "1.1",
					"letterSpacing": "-0.015em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"letterSpacing": "-0.01em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-dark)"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--primary-dark)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "600",
					"textDecoration": "none"
				},
				"border": {
					"radius": "var(--wp--custom--radius--md)"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"right": "1.5rem",
						"bottom": "0.75rem",
						"left": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-dark)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--primary-dark)"
					}
				},
				":active": {
					"color": {
						"background": "var(--wp--preset--color--primary-dark)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--ink-muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"textInput": {
				"color": {
					"background": "var(--wp--preset--color--base)",
					"text": "var(--wp--preset--color--ink)"
				},
				"border": {
					"color": "var(--wp--preset--color--ink-muted)",
					"width": "1px",
					"style": "solid",
					"radius": "var(--wp--custom--radius--md)"
				},
				"spacing": {
					"padding": {
						"top": "0.65rem",
						"right": "0.9rem",
						"bottom": "0.65rem",
						"left": "0.9rem"
					}
				}
			},
			"select": {
				"color": {
					"background": "var(--wp--preset--color--base)",
					"text": "var(--wp--preset--color--ink)"
				},
				"border": {
					"color": "var(--wp--preset--color--ink-muted)",
					"width": "1px",
					"style": "solid",
					"radius": "var(--wp--custom--radius--md)"
				},
				"spacing": {
					"padding": {
						"top": "0.65rem",
						"right": "0.9rem",
						"bottom": "0.65rem",
						"left": "0.9rem"
					}
				}
			}
		},
		"blocks": {
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "var(--wp--preset--font-size--xxx-large)",
					"lineHeight": "1.1"
				}
			},
			"core/heading": {
				"spacing": {
					"margin": {
						"top": "var(--wp--preset--spacing--30)",
						"bottom": "var(--wp--preset--spacing--10)"
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--line)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/post-date": {
				"color": {
					"text": "var(--wp--preset--color--ink-muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/post-terms": {
				"color": {
					"text": "var(--wp--preset--color--ink-muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/accordion": {
				"border": {
					"color": "var(--wp--preset--color--line)",
					"width": "1px",
					"style": "solid",
					"radius": "var(--wp--custom--radius--md)"
				}
			},
			"core/site-title": {
				"color": {
					"text": "currentColor"
				},
				"elements": {
					"link": {
						"color": {
							"text": "currentColor"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/site-tagline": {
				"color": {
					"text": "currentColor"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": []
}
