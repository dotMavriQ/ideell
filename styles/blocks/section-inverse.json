{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"slug": "section-inverse",
	"title": "Section, inverted",
	"blockTypes": ["core/group"],
	"styles": {
		"color": {
			"background": "var:preset|color|primary",
			"text": "var:preset|color|base"
		},
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|80",
				"bottom": "var:preset|spacing|80"
			},
			"blockGap": "var:preset|spacing|50"
		},
		"elements": {
			"heading": { "color": { "text": "currentColor" } },
			"link": {
				"color": { "text": "currentColor" },
				":hover": { "color": { "text": "currentColor" } }
			}
		},
		"blocks": {
			"core/site-title": {
				"color": { "text": "currentColor" },
				"elements": { "link": { "color": { "text": "currentColor" } } }
			},
			"core/post-date": { "color": { "text": "currentColor" } },
			"core/post-terms": { "color": { "text": "currentColor" } },
			"core/separator": { "color": { "text": "currentColor" } }
		}
	}
}
